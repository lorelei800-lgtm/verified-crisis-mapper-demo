{
  "name": "verified-crisis-mapper-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --nojekyll",
    "deploy:fresh": "npm run fusion:static && npm run build && gh-pages -d dist --nojekyll",
    "fusion": "node scripts/fusion/run.mjs",
    "fusion:static": "node scripts/fusion/run.mjs --dry-run --out=public/verified-events.json",
    "cms:bootstrap": "node scripts/bootstrap-bangkok.mjs",
    "cms:bootstrap:dry": "node scripts/bootstrap-bangkok.mjs --dry-run"
  },
  "dependencies": {
    "h3-js": "^4.1.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
